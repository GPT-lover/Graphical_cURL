# ---- Backend (Gradle / Java) ----
backend/.gradle/
backend/build/
backend/bin/
!backend/gradle/wrapper/gradle-wrapper.jar

# SQLite database files (created at runtime, not source)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# ---- Frontend (Node / Vite) ----
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- Electron desktop shell (Phase 12) ----
# Root Electron project dependencies + packaging output.
/node_modules/
/release/
# jlink runtime is generated into backend/build/jre (already covered by
# backend/build/ above) - listed here for clarity.
backend/build/jre/

# ---- Editors / OS ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local-only env overrides (committed defaults: .env.development)
frontend/.env.local
frontend/.env.*.local
